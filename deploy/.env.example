# Copiar a /opt/ppa/backend/.env en el droplet y rellenar.
# NUNCA subir el .env real a git.

# --- Base de datos ---
# Postgres local en el droplet (usuario/clave creados por setup-server.sh)
DATABASE_URL=postgresql://ppa:CAMBIAR_ESTA_CLAVE@localhost:5432/ppa

# --- Seguridad ---
# Generar con: openssl rand -hex 32
# Si esta variable falta, la app NO arranca (a proposito).
SECRET_KEY=

# --- CORS ---
# Origen exacto del frontend en Vercel, sin barra final.
FRONTEND_URL=https://proyecto-ppa.vercel.app

# --- Integraciones ---
DUFFEL_API_KEY=

# --- Backups (backup-db.sh) ---
# Credenciales de DigitalOcean Spaces. Dejar vacio para backup solo local.
SPACES_BUCKET=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_KEY=
SPACES_SECRET=
# Dias de retencion de dumps locales
BACKUP_RETENTION_DAYS=14
# Opcional: URL de healthcheck que se pinguea si el backup termina OK
BACKUP_PING_URL=
